// Build and publish the ClearSignage Home Assistant app image (Epic 119 Pass 4).
//
// The Supervisor can build an app on the user's own machine, and for a public
// add-on that is the friendlier default. It is the wrong choice here for one
// concrete reason: this image is built from a private repository, so a local
// build would need ClearSignage credentials to exist on every customer's Home
// Assistant.
//
// Publishing a prebuilt image keeps the source private, makes installation a
// pull rather than a lengthy compile on a CM4, and means every install runs the
// bytes that were tested rather than whatever resolves on the day.
//
// One multi-arch manifest, not per-architecture user-facing tags. The {arch}
// placeholder in image: is deprecated; a manifest list lets the Supervisor pull
// the correct image by itself.

pipeline {
    agent any

    parameters {
        string(
            name: 'CLEARSIGNAGE_REF',
            defaultValue: '',
            description: 'Approved ClearSignage commit/tag. Branches are allowed only with PUSH=false.'
        )

        booleanParam(
            name: 'PUSH',
            defaultValue: true,
            description: 'Push the manifest. Off builds both architectures and discards the output.'
        )
    }

    environment {
        REGISTRY = 'ghcr.io'
        IMAGE    = 'ghcr.io/workplain-com/clearsignage-ha'

        // Jenkins username/password credential for GHCR.
        //
        // Jenkins exposes:
        //   GHCR_USR
        //   GHCR_PSW
        //
        // The token requires permission to write packages.
        GHCR = credentials('ghcr-clearsignage')
    }

    stages {
        stage('Validate release request') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    yaml_scalar() {
                        # Do not escape double quotes inside this Groovy string.
                        # Groovy consumes those escapes before writing the temporary
                        # shell script, which previously left an unmatched quote.
                        awk -v key="$1" '
                            $1 == key ":" {
                                value = $2
                                sub(/^"/, "", value)
                                sub(/"$/, "", value)
                                print value
                                exit
                            }
                        ' "$2"
                    }
                    APP_VERSION="$(yaml_scalar version clearsignage/config.yaml)"
                    APPROVED_VERSION="$(yaml_scalar app_version clearsignage/release.yaml)"
                    APPROVED_REF="$(yaml_scalar clearsignage_ref clearsignage/release.yaml)"
                    APPROVED_REVISION="$(yaml_scalar clearsignage_revision clearsignage/release.yaml)"

                    if [ "${APP_VERSION}" != "${APPROVED_VERSION}" ]; then
                        echo "config version ${APP_VERSION} has no matching approved release metadata" >&2
                        exit 1
                    fi
                    if ! printf '%s' "${APPROVED_REVISION}" | grep -Eq '^[0-9a-f]{40}$'; then
                        echo "release metadata must contain a full ClearSignage commit SHA" >&2
                        exit 1
                    fi

                    if [ "${PUSH}" = "true" ]; then
                        [ -n "${CLEARSIGNAGE_REF}" ] || {
                            echo 'A publishing build requires an explicit CLEARSIGNAGE_REF' >&2
                            exit 1
                        }
                        [ "${CLEARSIGNAGE_REF}" = "${APPROVED_REF}" ] || {
                            echo "Publishing ref is not approved for app version ${APP_VERSION}" >&2
                            exit 1
                        }
                    elif [ -z "${CLEARSIGNAGE_REF}" ]; then
                        echo 'Development builds also require an explicit commit, tag, or branch' >&2
                        exit 1
                    fi
                '''
            }
        }

        stage('Verify tools') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    docker --version
                    docker buildx version

                    # Register ARM64 emulation for building the Home Assistant
                    # Yellow image on the AMD64 Jenkins machine.
                    docker run --privileged --rm \
                        tonistiigi/binfmt \
                        --install arm64

                    # Reuse the named builder when it already exists.
                    if docker buildx inspect clearsignage >/dev/null 2>&1; then
                        docker buildx use clearsignage
                        docker buildx inspect --bootstrap
                    else
                        docker buildx create \
                            --name clearsignage \
                            --driver docker-container \
                            --use \
                            --bootstrap
                    fi
                '''
            }
        }

        stage('Validate packaging') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    rm -rf .venv
                    python3 -m venv .venv

                    .venv/bin/python -m pip install \
                        --quiet \
                        --upgrade \
                        pip

                    .venv/bin/python -m pip install \
                        --quiet \
                        pytest \
                        pyyaml

                    .venv/bin/python -m pytest tests -q
                '''
            }
        }

        stage('Fetch ClearSignage source') {
            steps {
                // The Jenkins SCM checkout credential is only used by Jenkins'
                // own checkout step. It is not automatically available to a
                // separate git clone executed by fetch-source.sh.
                //
                // Bind the existing private-repository credential and expose it
                // to Git through a temporary GIT_ASKPASS script. This avoids
                // putting the PAT in the repository URL, shell arguments or Git
                // configuration.
                withCredentials([
                    usernamePassword(
                        credentialsId: 'GithubPAT-Workplain-com',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail

                        ASKPASS_SCRIPT="$(mktemp)"
                        trap 'rm -f "${ASKPASS_SCRIPT}"' EXIT

                        cat > "${ASKPASS_SCRIPT}" <<'EOF'
#!/usr/bin/env bash

case "$1" in
    *Username*)
        printf '%s\\n' "${GITHUB_USERNAME}"
        ;;
    *Password*)
        printf '%s\\n' "${GITHUB_TOKEN}"
        ;;
    *)
        exit 1
        ;;
esac
EOF

                        chmod 700 "${ASKPASS_SCRIPT}"

                        export GIT_ASKPASS="${ASKPASS_SCRIPT}"
                        export GIT_TERMINAL_PROMPT=0

                        CLEARSIGNAGE_REF="${CLEARSIGNAGE_REF}" \
                            ./scripts/fetch-source.sh
                    '''
                }

                script {
                    env.RESOLVED_REF = sh(
                        script: '''
                            set -e
                            cat clearsignage/src/CLEARSIGNAGE_REF
                        ''',
                        returnStdout: true
                    ).trim()

                    env.APP_VERSION = sh(
                        script: '''
                            set -e
                            python3 -c "import yaml; print(yaml.safe_load(open('clearsignage/config.yaml'))['version'])"
                        ''',
                        returnStdout: true
                    ).trim()

                    env.APPROVED_REVISION = sh(
                        script: '''
                            set -e
                            python3 -c "import yaml; print(yaml.safe_load(open('clearsignage/release.yaml'))['clearsignage_revision'])"
                        ''',
                        returnStdout: true
                    ).trim()
                }

                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    if [ "${PUSH}" = "true" ] && [ "${RESOLVED_REF}" != "${APPROVED_REVISION}" ]; then
                        echo "${CLEARSIGNAGE_REF} resolved to ${RESOLVED_REF}, not approved revision ${APPROVED_REVISION}" >&2
                        exit 1
                    fi
                '''

                echo "Building ClearSignage ${env.RESOLVED_REF} as app version ${env.APP_VERSION}"
            }
        }

        stage('Build and publish') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    AARCH64_FROM="$(
                        python3 -c "
import yaml
with open('clearsignage/build.yaml', encoding='utf-8') as file:
    print(yaml.safe_load(file)['build_from']['aarch64'])
"
                    )"

                    AMD64_FROM="$(
                        python3 -c "
import yaml
with open('clearsignage/build.yaml', encoding='utf-8') as file:
    print(yaml.safe_load(file)['build_from']['amd64'])
"
                    )"

                    if [ "${PUSH}" = "true" ]; then
                        printf '%s' "${GHCR_PSW}" |
                            docker login "${REGISTRY}" \
                                --username "${GHCR_USR}" \
                                --password-stdin

                        OUTPUT_MODE="--push"

                        # A released version is immutable. It may be retried only when
                        # the existing manifest records the same reviewed source SHA.
                        if docker buildx imagetools inspect "${IMAGE}:${APP_VERSION}" >/dev/null 2>&1; then
                            EXISTING_REVISION="$(
                                docker buildx imagetools inspect \
                                    --format '{{json .Image.Config.Labels}}' \
                                    "${IMAGE}:${APP_VERSION}-amd64" |
                                python3 -c "import json,sys; print((json.load(sys.stdin) or {}).get('org.opencontainers.image.revision', ''))"
                            )"
                            if [ "${EXISTING_REVISION}" != "${RESOLVED_REF}" ]; then
                                echo "Refusing to overwrite ${IMAGE}:${APP_VERSION}: existing revision '${EXISTING_REVISION:-missing}' differs from ${RESOLVED_REF}" >&2
                                exit 1
                            fi
                        fi
                    else
                        OUTPUT_MODE="--output=type=cacheonly"
                    fi

                    build_one() {
                        PLATFORM="$1"
                        BUILD_FROM="$2"
                        ARCH_TAG="$3"

                        docker buildx build \
                            --builder clearsignage \
                            --platform "${PLATFORM}" \
                            --build-arg "BUILD_FROM=${BUILD_FROM}" \
                            --build-arg "CLEARSIGNAGE_REF=${RESOLVED_REF}" \
                            --label "org.opencontainers.image.revision=${RESOLVED_REF}" \
                            --label "org.opencontainers.image.version=${APP_VERSION}" \
                            --tag "${IMAGE}:${APP_VERSION}-${ARCH_TAG}" \
                            ${OUTPUT_MODE} \
                            clearsignage
                    }

                    # Home Assistant Yellow / ARM64.
                    build_one \
                        "linux/arm64" \
                        "${AARCH64_FROM}" \
                        "aarch64"

                    # AMD64 is retained for Home Assistant installations running
                    # on Intel or AMD hardware.
                    build_one \
                        "linux/amd64" \
                        "${AMD64_FROM}" \
                        "amd64"

                    if [ "${PUSH}" = "true" ]; then
                        # Assemble the architecture-specific images into the
                        # user-facing multi-architecture manifest.
                        docker buildx imagetools create \
                            --tag "${IMAGE}:${APP_VERSION}" \
                            --tag "${IMAGE}:latest" \
                            "${IMAGE}:${APP_VERSION}-aarch64" \
                            "${IMAGE}:${APP_VERSION}-amd64"

                        docker buildx imagetools inspect \
                            "${IMAGE}:${APP_VERSION}"
                    fi
                '''
            }
        }
    }

    post {
        always {
            sh '''#!/usr/bin/env bash
                set +e

                docker logout "${REGISTRY}"

                # Remove the private ClearSignage checkout and temporary Python
                # environment from the Jenkins workspace.
                rm -rf clearsignage/src
                rm -rf .venv
            '''
        }

        success {
            echo "Published ${env.IMAGE}:${env.APP_VERSION} from ClearSignage commit ${env.RESOLVED_REF}"
        }

        failure {
            echo 'ClearSignage Home Assistant image build failed.'
        }
    }
}
