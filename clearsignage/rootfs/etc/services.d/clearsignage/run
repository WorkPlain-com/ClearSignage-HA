#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# Start ClearVenue, hosted by Home Assistant (Epic 119 Pass 4; DP92).
#
# Everything here is translation: read what the operator set in the app's options, work
# out the one thing they are allowed to leave blank, and exec. The decisions live in the
# `clearvenue` and `hosted` packages, which are testable; this file is the seam that
# cannot be, so it stays small enough to read in one go.
#
# **Why `-m clearvenue` and not `-m hosted`.** ClearVenue is a *role* — a machine that
# runs several screens and is also the venue's source of truth for authoritative data
# (a till today, a calendar or a transport board later) — and how that role is hosted is
# a swappable value inside the package (`clearvenue/hosts/`). `hosted` alone is the
# supervisor half: it runs the screens and has no till, no enrolment and no replication
# lane, which is what this add-on shipped before and why an operator here found the
# Screens page and nothing else. Every Home Assistant install is a venue.
#
# The fleet does not move. `clearvenue.paths` resolves its root to `/data` on this
# platform — the same `/data/instances.json` and `/data/instances/<n>/` the supervisor
# has always used — so an existing install keeps its screens and their content.
set -euo pipefail

export CLEARVENUE_HOST
export CLEARVENUE_BUILD
export CLEARSIGNAGE_VHOST_PORT
export CLEARSIGNAGE_HOST_IP
export CLEARSIGNAGE_APP_DIR

# Which platform is hosting the venue (DP92). Decides that Home Assistant has already
# authenticated the operator, so no second sign-in is mounted (DP87), and that the app is
# served on two listeners rather than binding a privileged port itself.
CLEARVENUE_HOST=home-assistant

# Which build this is, for the venue's About page — the number an operator quotes when
# they report something. The app knows its own version and the venue does not, so this is
# the only place the two meet. Never fatal: a blank build simply leaves the row off that
# page, which is better than an app that will not start because it could not name itself.
CLEARVENUE_BUILD="$(bashio::addon.version 2>/dev/null || true)"
if [ "${CLEARVENUE_BUILD}" = "null" ]; then
    CLEARVENUE_BUILD=""
fi

CLEARSIGNAGE_VHOST_PORT="$(bashio::config 'vhost_port')"
# The directory holding the `app` package, matching the appliance's SIGNAGE_APP_DIR.
# The Dockerfile sets this; the fallback only matters if someone runs the image with it
# unset, and it agreeing with the Dockerfile is the point.
CLEARSIGNAGE_APP_DIR="${CLEARSIGNAGE_APP_DIR:-/opt/clearsignage/device}"

# The address peers reach this host at (DP65). Never sniffed inside the container: with
# host_network we see every interface the host has, and choosing the wrong one makes
# every screen advertise an endpoint that resolves nowhere useful. The operator may leave
# it blank, in which case the address on the default route is the best available answer —
# and it is announced in the log, because a wrong guess here is invisible until a peer
# fails to sync and nobody knows why.
CLEARSIGNAGE_HOST_IP="$(bashio::config 'host_ip')"

# bashio::config hands back the *string* "null" for an option the operator cleared, so
# an unset host_ip would otherwise be advertised to every peer verbatim.
if [ "${CLEARSIGNAGE_HOST_IP}" = "null" ]; then
    CLEARSIGNAGE_HOST_IP=""
fi

if bashio::var.is_empty "${CLEARSIGNAGE_HOST_IP}"; then
    # `|| true` because of `set -e` above: without it a failure here kills the service
    # before the check below can say why, which is exactly what it looked like from the
    # outside — a container that exited instantly having logged nothing at all.
    CLEARSIGNAGE_HOST_IP="$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}' || true)"
    if bashio::var.is_empty "${CLEARSIGNAGE_HOST_IP}"; then
        bashio::log.warning "Could not read this host's address from the default route."
    else
        bashio::log.info "host_ip not set; using ${CLEARSIGNAGE_HOST_IP} from the default route."
        bashio::log.info "Set host_ip in the app options if peers should reach this host elsewhere."
    fi
fi

if bashio::var.is_empty "${CLEARSIGNAGE_HOST_IP}"; then
    bashio::exit.nok "Could not determine this host's address. Set host_ip in the app options."
fi

# Port 80 is the default because a typed .local URL should have no port in it (DP66), and
# it is also the likeliest thing on the host to already be taken. Say so plainly now
# rather than letting the operator find a half-working app: the screens themselves and
# ingress are unaffected, only the friendly names are lost.
if [ "${CLEARSIGNAGE_VHOST_PORT}" -eq 80 ] && ! bashio::net.wait_for 80 127.0.0.1 1; then
    bashio::log.debug "Port 80 looks free."
fi

bashio::log.info "Starting ClearVenue (host ${CLEARSIGNAGE_HOST_IP}, names on :${CLEARSIGNAGE_VHOST_PORT})."

exec /opt/venv/bin/python -m clearvenue
